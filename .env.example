# Public address that users' browsers use to reach the backend.
# Use a DNS name or server IP, not the Docker service name.
VITE_API_HOST=YOUR_SERVER_IP_OR_DOMAIN
VITE_API_PORT=3000
VITE_API_PROTOCOL=http
VITE_WS_PROTOCOL=ws

# Host ports
FRONTEND_PORT=8080
BACKEND_PORT=3000
MYSQL_PORT=13306

# MySQL credentials
MYSQL_DATABASE=uav_detection
MYSQL_USER=bobo
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Use a long random value in production.
JWT_SECRET=change-this-to-a-long-random-secret